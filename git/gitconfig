	name = Jose Carrero
	email = josercl@gmail.com
[core]
	editor = vim
	excludesfile = ~/.gitignore
	autocrlf = input
[color]
	ui = true
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red
[alias]
	st = status
	co = checkout
	ci = commit
	lol = log --oneline --graph
	pr = pull --rebase
	pnr = pull --no-rebase
[web]
	browser = firefox
